{
  "compilerOptions": {
	"strict": true,
	"outDir": "build",
	"module": "node20", //needed for settings.json loading
	"target": "es2022",
	"moduleResolution": "node16",
	"resolveJsonModule": true,
	"typeRoots": ["node_modules/@types"],
	"types": ["node"],
  },
  "include": ["./"],
  "exclude": ["./build", "./node_modules"]
}